# ── UniFi Protect ──────────────────────────────────────────────
# Normally written to /config/runtime-settings.json by the authenticated wizard.
# Set these only when intentionally overriding wizard-managed values.
UNIFI_PROTECT_HOST=
UNIFI_PROTECT_PORT=
UNIFI_PROTECT_USERNAME=
UNIFI_PROTECT_PASSWORD=
# Leave blank for system trust; set only to intentionally override wizard-managed trust.
UNIFI_PROTECT_VERIFY_SSL=

# ── UniFi Access ───────────────────────────────────────────────
UNIFI_ACCESS_HOST=192.168.1.10
UNIFI_ACCESS_TOKEN=change-me
# true (default) or an absolute path to the controller CA bundle.
UNIFI_ACCESS_VERIFY_SSL=true

# ── Nexus Base44 alert ingestion ───────────────────────────────
# POST target: the nexusVisionIngest function on the NexusCT app
BASE44_ALERT_URL=https://nexusct.com/api/functions/nexusVisionIngest
BASE44_INTERNAL_TOKEN=change-me
# Door unlock stays disabled until this is replaced with a strong random bearer token.
VISION_CONTROL_TOKEN=change-me-before-enabling-door-control
# Subscription status/list/manage routes stay disabled until this is replaced.
VISION_ADMIN_TOKEN=change-me-before-enabling-admin-api
# Optional generic JSON webhook or integration relay — leave blank to disable
EXTRA_WEBHOOK_URL=

# ── Runtime ────────────────────────────────────────────────────
# cuda | cpu (compose profiles set this too)
VISION_DEVICE=cuda
# Frame analysis interval per stream (seconds). Lower = more GPU load.
VISION_FRAME_INTERVAL=1.0
# Container paths (Compose and Unraid templates set these authoritatively).
VISION_CONFIG=/config/sites.yaml
VISION_RUNTIME_SETTINGS=/config/runtime-settings.json
VISION_DATA=/data
VISION_MODELS=/models
VISION_EVIDENCE=/evidence
# Persistent appliance identity/entitlement state and public-only Ed25519 trust anchors.
VISION_LICENSE_DIR=/config/licensing
VISION_ENTITLEMENT_TRUST_STORE=/config/trusted-entitlement-keys.json
VISION_SETUP_RESTART_ENABLED=false
# Maximum age of the latest decoded frame before /ready fails.
VISION_READY_MAX_FRAME_AGE_SECONDS=30
# Public lead-capture abuse and storage bounds.
VISION_SIGNUP_RATE_LIMIT_PER_MINUTE=5
VISION_SIGNUP_MAX_BODY_BYTES=32768
VISION_SUBSCRIPTION_MAX_RECORDS=10000
# API snapshot lifecycle limits are independent from alert-image and exported-video policies.
VISION_SNAPSHOT_RETENTION_DAYS=30
VISION_SNAPSHOT_MAX_FILES=5000
VISION_SNAPSHOT_STORAGE_QUOTA_BYTES=5368709120
