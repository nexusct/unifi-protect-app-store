# ── UniFi Protect ──────────────────────────────────────────────
UNIFI_PROTECT_HOST=192.168.1.10
UNIFI_PROTECT_PORT=443
UNIFI_PROTECT_USERNAME=vision-readonly
UNIFI_PROTECT_PASSWORD=change-me
# SSL verification: true (recommended) | false (self-signed certs only)
# SECURITY WARNING: Setting to 'false' disables certificate validation and
# creates a man-in-the-middle risk. Only use on trusted isolated networks.
# See SECURITY.md for production recommendations.
UNIFI_PROTECT_VERIFY_SSL=true

# ── UniFi Access ───────────────────────────────────────────────
UNIFI_ACCESS_HOST=192.168.1.10
UNIFI_ACCESS_TOKEN=change-me
# SSL verification: true (recommended) | false (self-signed certs only)
# SECURITY WARNING: Setting to 'false' disables certificate validation and
# creates a man-in-the-middle risk. Only use on trusted isolated networks.
UNIFI_ACCESS_VERIFY_SSL=true

# ── Nexus Base44 alert ingestion ───────────────────────────────
# POST target: the nexusVisionIngest function on the NexusCT app
BASE44_ALERT_URL=https://nexusct.com/api/functions/nexusVisionIngest
BASE44_INTERNAL_TOKEN=change-me
# Optional extra webhook (Slack/Teams/generic) — leave blank to disable
EXTRA_WEBHOOK_URL=

# ── Runtime ────────────────────────────────────────────────────
# cuda | cpu (compose profiles set this too)
VISION_DEVICE=cuda
# Frame analysis interval per stream (seconds). Lower = more GPU load.
VISION_FRAME_INTERVAL=1.0
# Clip/snapshot retention dir inside container (mounted to ./data)
VISION_DATA=/app/data
# Admin token for the subscription management API (list/update signups)
# SECURITY: Generate a strong random token: openssl rand -hex 32
# This token grants full access to subscription data via /api/subscriptions
VISION_ADMIN_TOKEN=change-me
